		)
		(uuid "79493c3b-de9e-4b0f-bb69-956d33ce4b6c")
	)
	(text_box "tss = 0.6(Css/1u) if tss = 600us, then \nCss=1u(600u/0.6) = 1nF \n\nRsense = Vsense_max/(Iout_max-dIL_max/2) "
		(exclude_from_sim no)
		(at 13.97 193.04 0)
		(size 38.1 10.16)
		(margins 0.5999 0.5999 0.5999 0.5999)
