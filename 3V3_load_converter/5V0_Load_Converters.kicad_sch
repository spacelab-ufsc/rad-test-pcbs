	(text_box "Vout = 0.6(1+RFB2/RFB1) \n\nRFB2 = RFB1(Vo/0.6 - 1) if RFB1=3k and Vo=5V, then \nRFB2 = 3000*(5/0.6 - 1) = 22kOhm "
		(exclude_from_sim no)
		(at 13.97 161.29 0)
		(size 38.1 10.16)
		(margins 0.5999 0.5999 0.5999 0.5999)
		(stroke
